# ---- GoHighLevel (server-side only, never exposed to the browser) ----
# Option A (recommended): GHL API v2 with a Private Integration token
# Settings > Private Integrations > create token with scopes:
#   contacts.write, contacts.readonly, opportunities.write (if using pipeline)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: also create an opportunity in this pipeline/stage
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional: map form answers into GHL custom fields (custom field IDs from Settings > Custom Fields)
# JSON: {"property_type":"<id>","service_type":"<id>","timeline":"<id>","city":"<id>","gclid":"<id>","utm_campaign":"<id>","utm_term":"<id>"}
GHL_CUSTOM_FIELD_IDS=

# Option B: GHL Workflow "Inbound Webhook" trigger URL (used if set; can be combined with A as a backup)
GHL_WEBHOOK_URL=

# ---- Google Ads (public) ----
NEXT_PUBLIC_GADS_ID=AW-17120170393
# "AW-XXXXXXXXX/label" of the conversion action to fire on the thank-you page
NEXT_PUBLIC_GADS_CONVERSION=AW-17120170393/rv8nCMj5zIAbEJmjxOM_
# Optional Google Tag Manager container
NEXT_PUBLIC_GTM_ID=
