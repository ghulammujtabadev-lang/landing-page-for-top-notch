# Copy these into Vercel → Project → Settings → Environment Variables (Production + Preview).
# Full walkthrough: docs/GHL-AND-GOOGLE-ADS-SETUP.md

# ---- GoHighLevel API v2 (server-side only, never exposed to the browser) ----
# GHL sub-account → Settings → Private Integrations → Create new integration. Scopes:
#   View Contacts, Edit Contacts, View Custom Fields, View Opportunities, Edit Opportunities
GHL_PRIVATE_TOKEN=
# GHL sub-account → Settings → Business Profile → "Location ID"
GHL_LOCATION_ID=
# Create a new opportunity for every lead in this pipeline (matched by name). Stage defaults to the first one.
GHL_PIPELINE_NAME=Residential Security
GHL_PIPELINE_STAGE_NAME=New Lead
# Advanced alternatives to the name lookups above (normally leave empty):
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_CUSTOM_FIELD_IDS=

# ---- Optional: GHL Workflow "Inbound Webhook" trigger URL (instead of, or as backup to, the API) ----
GHL_WEBHOOK_URL=

# ---- Google Ads (public). Defaults to the main site's existing tag/conversion if empty. ----
NEXT_PUBLIC_GADS_ID=AW-17120170393
# "AW-17120170393/<label>" of the "Residential LP - Lead" conversion action
NEXT_PUBLIC_GADS_CONVERSION=
# Optional Google Tag Manager container
NEXT_PUBLIC_GTM_ID=
